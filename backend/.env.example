# Port on which the backend server runs (standard fallback is 5000)
PORT=5000

# Database Configuration
# Supported options: 'sqlite' or 'mysql'
DB_DIALECT="sqlite"

# MySQL Settings (Only active if DB_DIALECT is set to 'mysql')
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="routine_manager"

# Security Configurations
JWT_SECRET="university-routine-secret-key-9988"

# Google Gemini AI API Configuration
# Add your secret API Key from Google AI Studio to enable intelligent schedule analysis
GEMINI_API_KEY=""
